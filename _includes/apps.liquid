<div class="col">
  <a href="{% if app.redirect %}{{ app.redirect }}{% else %}{{ app.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      {% if app.img %}
        {%
          include figure.liquid
          loading="eager"
          path=app.img
          sizes = "250px"
          alt="app thumbnail"
          class="card-img-top"
        %}
      {% endif %}
      <div class="card-body">
        <h2 class="card-title">{{ app.title }}</h2>
        <p class="card-text">{{ app.description }}</p>
      </div>
    </div>
  </a>
</div>
