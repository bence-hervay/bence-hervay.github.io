---
layout: default
---
{% comment %}
  Local override of the al_folio_cv gem's own _layouts/cv.liquid (kept in sync
  with it — see the "PDF viewer" block below, which is the only addition).
  The gem's `al_folio_cv_render` tag renders the whole rendered-CV block itself
  and does not yield to the page's markdown body, so an inline PDF viewer has
  to be added here rather than in _pages/cv.md.
{% endcomment %}
{% assign cv_feature_enabled = site.al_folio.features.cv.enabled | default: true %}

{% if site.plugins contains 'al_folio_cv' and cv_feature_enabled %}
  {% al_folio_cv_render %}
  {% if page.cv_pdf %}
    <div class="post">
      <article>
        <div class="cv">
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">PDF</h3>
            <p>
              <a
                href="{{ page.cv_pdf | relative_url }}"
                class="btn btn-outline-primary"
                download
                target="_blank"
                rel="noopener noreferrer"
              >
                <i class="fa-solid fa-file-pdf"></i> Download the CV as a PDF
              </a>
            </p>
            <embed
              src="{{ page.cv_pdf | relative_url }}"
              type="application/pdf"
              style="width: 100%; height: 85vh; border: 1px solid rgba(128, 128, 128, 0.3); border-radius: 4px;"
            />
            <p class="text-muted mt-2" style="font-size: 0.85em;">
              If the PDF does not display above (some mobile browsers cannot embed
              PDFs), use the download link.
            </p>
          </div>
        </div>
      </article>
    </div>
  {% endif %}
{% else %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      <p class="post-description">CV rendering is unavailable.</p>
    </header>
    <article>
      <p>Enable the <code>al_folio_cv</code> plugin and set <code>al_folio.features.cv.enabled: true</code> to render this page.</p>
    </article>
  </div>
{% endif %}
